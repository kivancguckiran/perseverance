{
  "name": "persistent-codex-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "alpha:dev": "node scripts/alpha-dev.mjs",
    "alpha:accept": "node scripts/alpha-accept.mjs",
    "alpha:canary": "node scripts/alpha-canary.mjs",
    "alpha:soak": "tsx scripts/alpha-soak.ts",
    "alpha:lifecycle": "tsx scripts/alpha-lifecycle.ts",
    "dev": "pnpm --parallel --filter @persistent-codex/control-plane --filter @persistent-codex/web dev",
    "demo:smoke": "pnpm test -- --run services/control-plane/src/server.test.ts packages/codex-event-adapter/src/index.test.ts && pnpm --filter @persistent-codex/workspace-agent smoke:unknown-replay && pnpm --filter @persistent-codex/workspace-agent smoke:real-recovery",
    "provider:smoke:claude": "tsx scripts/provider-smoke.ts claude",
    "provider:smoke:gemini": "tsx scripts/provider-smoke.ts gemini",
    "provider:smoke:cursor": "tsx scripts/provider-smoke.ts cursor",
    "provider:smoke:title": "tsx scripts/provider-title-smoke.ts",
    "phase2:accept": "node scripts/phase2-accept.mjs",
    "phase2:accept:browser": "VITE_CONTROL_PLANE_URL=http://127.0.0.1:3216 pnpm --filter @persistent-codex/web build && tsx scripts/phase2-browser-accept.ts",
    "phase2:smoke:live": "pnpm alpha:canary && pnpm provider:smoke:claude && pnpm provider:smoke:gemini && pnpm provider:smoke:title",
    "demo:golden:read-only": "WP8_GOLDEN_SCENARIO=read-only pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "demo:golden:change": "WP8_GOLDEN_SCENARIO=change pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "demo:golden:approval": "WP8_GOLDEN_SCENARIO=approval pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @persistent-codex/web test:ssr-http"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
