{
  "name": "persistent-codex-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "alpha:dev": "node scripts/alpha-dev.mjs",
    "alpha:accept": "node scripts/alpha-accept.mjs",
    "alpha:canary": "node scripts/alpha-canary.mjs",
    "alpha:soak": "tsx scripts/alpha-soak.ts",
    "alpha:lifecycle": "tsx scripts/alpha-lifecycle.ts",
    "dev": "pnpm --parallel --filter @persistent-codex/control-plane --filter @persistent-codex/web dev",
    "demo:smoke": "pnpm test -- --run services/control-plane/src/server.test.ts packages/codex-event-adapter/src/index.test.ts && pnpm --filter @persistent-codex/workspace-agent smoke:unknown-replay && pnpm --filter @persistent-codex/workspace-agent smoke:real-recovery",
    "provider:smoke:claude": "tsx scripts/provider-smoke.ts claude",
    "provider:smoke:gemini": "tsx scripts/provider-smoke.ts gemini",
    "provider:smoke:cursor": "tsx scripts/provider-smoke.ts cursor",
    "provider:smoke:title": "tsx scripts/provider-title-smoke.ts",
    "phase2:accept": "node scripts/phase2-accept.mjs",
    "phase2:accept:browser": "VITE_CONTROL_PLANE_URL=http://127.0.0.1:3216 pnpm --filter @persistent-codex/web build && tsx scripts/phase2-browser-accept.ts",
    "phase2:smoke:live": "pnpm alpha:canary && pnpm provider:smoke:claude && pnpm provider:smoke:gemini && pnpm provider:smoke:title",
    "wp18:postgres": "node scripts/wp18-postgres-rls-smoke.mjs",
    "wp19:test": "pnpm test -- --run packages/workspace-security/src/index.test.ts",
    "wp19:postgres": "node scripts/wp19-postgres-encryption-smoke.mjs",
    "wp19:kms-smoke": "node scripts/wp19-aws-kms-smoke.mjs",
    "wp19:runtime-smoke": "node scripts/wp19-kata-runtime-smoke.mjs",
    "wp19:key-rotation": "node --import tsx scripts/wp19-key-rotation.ts",
    "wp19:crypto-erasure": "node --import tsx scripts/wp19-crypto-erasure.ts",
    "wp19:backup-restore": "node --import tsx scripts/wp19-backup-restore.ts",
    "wp20:test": "pnpm test -- --run packages/support-access/src/index.test.ts packages/authz/src/index.test.ts services/control-plane/src/server-auth.test.ts apps/web/src/workspace-page.test.ts",
    "wp20:postgres": "node scripts/wp20-postgres-governance-smoke.mjs",
    "wp21:test": "pnpm test -- --run packages/corpus-ingestion/src/index.test.ts services/control-plane/src/corpus-api.test.ts apps/web/src/workspace-page.test.ts",
    "wp21:postgres": "node --import tsx scripts/wp21-postgres-corpus-smoke.ts",
    "wp21:browser": "node --import tsx scripts/wp21-browser-accept.ts",
    "wp22:test": "pnpm exec vitest run packages/corpus-ingestion/src/retrieval.test.ts packages/authz/src/index.test.ts agents/workspace-agent/src/corpus-mcp.test.ts agents/workspace-agent/src/workspace-corpus-watcher.test.ts agents/workspace-agent/src/runtime-corpus-integration.test.ts services/control-plane/src/corpus-api.test.ts",
    "wp22:postgres": "node --import tsx scripts/wp22-postgres-retrieval-smoke.ts",
    "wp22:agent-e2e": "node --import tsx scripts/wp22-agent-retrieval-e2e.ts",
    "wp22:browser": "node --import tsx scripts/wp22-browser-accept.ts",
    "wp22:accept": "node --import tsx scripts/wp22-accept.ts",
    "wp23:test": "pnpm exec vitest run packages/push-notifications/src/index.test.ts services/control-plane/src/push-api.test.ts services/control-plane/src/server.test.ts apps/web/src/pwa-assets.test.ts apps/web/src/workspace-page.test.ts",
    "wp23:postgres": "node --import tsx scripts/wp23-postgres-push-smoke.ts",
    "wp23:browser": "node --import tsx scripts/wp23-browser-accept.ts",
    "wp23:accept": "node --import tsx scripts/wp23-accept.ts",
    "wp24:test": "pnpm exec vitest run packages/billing-platform/src/index.test.ts packages/provider-platform/src/index.test.ts packages/event-store/src/index.test.ts packages/corpus-ingestion/src/index.test.ts packages/corpus-ingestion/src/retrieval.test.ts services/control-plane/src/main-composition.test.ts services/control-plane/src/server.test.ts services/control-plane/src/corpus-api.test.ts apps/web/src/workspace-page.test.ts",
    "wp24:prepaid": "pnpm exec vitest run packages/billing-platform/src/prepaid-credit.test.ts packages/billing-platform/src/index.test.ts",
    "wp24:postgres": "node --import tsx scripts/wp24-postgres-billing-smoke.ts",
    "wp24:e2e": "node --import tsx scripts/wp24-unified-e2e.ts",
    "wp24:browser": "WP24_UNIFIED_BROWSER=1 node --import tsx scripts/wp24-unified-e2e.ts",
    "wp25:test": "pnpm exec vitest run packages/shared-folders/src/index.test.ts services/control-plane/src/shared-folders-api.test.ts services/control-plane/src/server-auth.test.ts apps/web/src/workspace-page.test.ts",
    "wp25:postgres": "node --import tsx scripts/wp25-postgres-shared-folders.ts",
    "wp25:e2e": "node --import tsx scripts/wp25-collaboration-e2e.ts",
    "wp25:browser": "node --import tsx scripts/wp25-browser-accept.ts",
    "wp26:test": "pnpm exec vitest run packages/production-topology/src/index.test.ts services/control-plane/src/topology-composition.test.ts services/control-plane/src/server.test.ts",
    "wp26:postgres": "node --import tsx scripts/wp26-postgres-ha.ts",
    "wp26:ha": "node --import tsx scripts/wp26-ha-accept.ts",
    "wp26:scheduler": "node --import tsx scripts/wp26-scheduler-runtime.ts",
    "wp26:capacity": "node --import tsx scripts/wp26-capacity-linux.ts",
    "wp26:browser": "node --import tsx scripts/wp26-browser-accept.ts",
    "wp26:accept": "node --import tsx scripts/wp26-accept.ts",
    "wp27:test": "pnpm exec vitest run packages/production-observability/src/index.test.ts services/control-plane/src/production-observability.test.ts",
    "wp27:otel": "node --import tsx scripts/wp27-otel.ts",
    "wp27:postgres-pitr": "node --import tsx scripts/wp27-postgres-pitr.ts",
    "wp27:restore": "node --import tsx scripts/wp27-restore.ts",
    "wp27:game-day": "node --import tsx scripts/wp27-game-day.ts",
    "wp27:alerts": "node --import tsx scripts/wp27-alerts.ts",
    "wp27:telemetry-scan": "node --import tsx scripts/wp27-telemetry-scan.ts",
    "wp27:e2e": "node --import tsx scripts/wp27-e2e.ts",
    "wp27:accept": "node --import tsx scripts/wp27-accept.ts",
    "wp28:test": "node --import tsx scripts/wp28-domain-gate.ts wp28:test",
    "wp28:postgres": "node scripts/wp28-postgres.mjs",
    "wp28:identity": "node --import tsx scripts/wp28-keycloak-identity.ts",
    "wp28:scim": "node --import tsx scripts/wp28-scim-integration.ts",
    "wp28:retention": "node --import tsx scripts/wp28-retention-integration.ts",
    "wp28:export": "node --import tsx scripts/wp28-export-integration.ts",
    "wp28:delete": "node --import tsx scripts/wp28-delete-integration.ts",
    "wp28:residency": "node --import tsx scripts/wp28-residency-integration.ts",
    "wp28:e2e": "node --import tsx scripts/wp28-e2e.ts",
    "wp28:browser": "node --import tsx scripts/wp28-browser.ts",
    "wp28:accept": "node --import tsx scripts/wp28-accept.ts",
    "phase4:accept": "node --import tsx scripts/phase4-accept.ts",
    "phase3:accept:browser": "VITE_CONTROL_PLANE_URL=http://127.0.0.1:3217 pnpm --filter @persistent-codex/web build && tsx scripts/phase3-browser-security-accept.ts",
    "phase3:accept": "node scripts/phase3-accept.mjs",
    "demo:golden:read-only": "WP8_GOLDEN_SCENARIO=read-only pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "demo:golden:change": "WP8_GOLDEN_SCENARIO=change pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "demo:golden:approval": "WP8_GOLDEN_SCENARIO=approval pnpm --filter @persistent-codex/workspace-agent smoke:poc-demo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @persistent-codex/web test:ssr-http"
  },
  "devDependencies": {
    "@authenio/samlify-xsd-schema-validator": "^1.0.5",
    "@openai/codex": "0.144.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.5",
    "samlify": "^2.13.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
