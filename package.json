{
  "name": "perseverance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "alpha:dev": "node scripts/alpha-dev.mjs",
    "dev": "pnpm --parallel --filter @perseverance/control-plane --filter @perseverance/web dev",
    "deploy:remote": "bash scripts/deploy-self-hosted-remote.sh",
    "deploy:self-hosted": "bash scripts/deploy-self-hosted.sh",
    "demo:smoke": "pnpm test -- --run services/control-plane/src/server.test.ts packages/codex-event-adapter/src/index.test.ts && pnpm --filter @perseverance/workspace-agent smoke:unknown-replay && pnpm --filter @perseverance/workspace-agent smoke:real-recovery",
    "provider:smoke:claude": "tsx scripts/provider-smoke.ts claude",
    "provider:smoke:gemini": "tsx scripts/provider-smoke.ts gemini",
    "provider:smoke:cursor": "tsx scripts/provider-smoke.ts cursor",
    "provider:smoke:title": "tsx scripts/provider-title-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "release:public-preflight": "node --import tsx scripts/public-release-preflight.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm --filter @perseverance/web test:ssr-http"
  },
  "devDependencies": {
    "@openai/codex": "0.144.2",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "esbuild": "0.28.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3": "3.1.4",
      "fast-uri@4": "4.1.1",
      "find-my-way@9": "9.7.0"
    }
  }
}
