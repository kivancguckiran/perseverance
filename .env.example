# Copy this file to .env.local. `pnpm alpha:dev` loads it without overriding
# environment values already exported by the parent process.

# Non-secret config files. Local alpha uses these paths by default.
PERSISTENT_PROVIDER_CATALOGS_FILE=config/provider-catalogs.local.json
PERSISTENT_PRICE_CATALOG_FILE=config/provider-prices.standard.json

# Official provider cost reconciliation is opt-in and requires a dedicated
# organization/admin credential. Never reuse an inference or CLI login token.
PERSISTENT_RECONCILIATION_DEDICATED_SCOPE=1
OPENAI_ADMIN_KEY=
OPENAI_RECONCILIATION_PROJECT_ID=
OPENAI_RECONCILIATION_API_KEY_ID=
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_RECONCILIATION_WORKSPACE_ID=

# Subscription CLI sessions continue to work without these values. Their cost
# is an API list-price estimate, not an invoice or subscription charge.

# WP26 production topology (do not enable these for local alpha). Readiness URLs
# are internal, authenticated service endpoints; credentials belong in the
# production secret provider, never in this file.
EVENT_STORE_BACKEND=postgresql
SCHEDULER_QUEUE_BACKEND=postgresql
SCHEDULER_LOCK_BACKEND=postgresql
ARTIFACT_STORAGE_BACKEND=object-storage
ATTACHMENT_STORAGE_BACKEND=object-storage
SOURCE_STORAGE_BACKEND=object-storage
PERSISTENT_INSTANCE_ID=
PERSISTENT_INSTANCE_ROLE=api
TOPOLOGY_DATABASE_URL=
EVENT_BROKER_READINESS_URL=
OBJECT_STORAGE_READINESS_URL=
RUNTIME_CONTROL_READINESS_URL=
KMS_READINESS_URL=
