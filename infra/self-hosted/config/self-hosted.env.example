#  self-hosted kurulum yapılandırması (örnek).
# `self-hosted.sh install` bu dosyayı temel alarak ${SELF_HOSTED_HOME}/config/
# altında gerçek self-hosted.env dosyasını üretir; secret alanları kurulumda
# openssl rand ile doldurulur ve dosya 0600 izinli tutulur.

# --- Zorunlu kurulum girdileri -------------------------------------------------
# Kanonik alan adı (TLS sertifikası ve public origin bu alan adına bağlanır).
SELF_HOSTED_DOMAIN=workspace.example.com
# acme  : Let's Encrypt HTTP-01 (public DNS + 80/443 erişimi ister; e-posta zorunlu)
# internal: Caddy iç CA (LAN / hava-boşluklu kurulum)
# custom: operatör sertifikası (config/tls/cert.pem + config/tls/key.pem)
SELF_HOSTED_TLS_MODE=acme
SELF_HOSTED_ACME_EMAIL=admin@example.com

# --- Kurulum yerleşimi ---------------------------------------------------------
# Durum dizini (config, secrets, backups, release durumu). Varsayılan:
# /var/lib/perseverance ; kök olmayan kurulumda $HOME/.perseverance önerilir.
SELF_HOSTED_HOME=/var/lib/perseverance

# --- Ağ ------------------------------------------------------------------------
# Proxy'nin bağlanacağı adres. Tek dışa açık servis proxy'dir (80/443).
SELF_HOSTED_HTTP_BIND=0.0.0.0
SELF_HOSTED_HTTPS_BIND=0.0.0.0
# (ADR-0038): reverse-proxy alt-path'i (örn. /workspace). Boş = kök.
# Başta '/', sonda '/' yok; segmentler [A-Za-z0-9._~-]; /v1,/healthz,/readyz,
# /assets,/events ile çakışamaz. Base build-time'dır: değer değişikliği
# 'self-hosted.sh install/upgrade' ile yeni imaj build'i gerektirir.
SELF_HOSTED_BASE_PATH=

# --- Kimlik --------------------------------------------------------------------
# Varsayılan: gömülü iç OIDC issuer (http://identity:3303). Dış OIDC sağlayıcı
# (ör. Keycloak) kullanmak için issuer/audience değerlerini değiştirin; bu durumda
# admin-token komutu yerine sağlayıcınızın token akışı geçerlidir.
SELF_HOSTED_OIDC_ISSUER=http://identity:3303
SELF_HOSTED_OIDC_AUDIENCE=persistent-codex-self-hosted
SELF_HOSTED_ADMIN_SUBJECT=self-hosted-admin
SELF_HOSTED_ORGANIZATION_NAME=Self-hosted organization
# kayıt olabilecek kullanıcı adları (virgülle ayrık, küçük harf).
# Liste dışı kayıt denemeleri fail-closed reddedilir ve audit'e düşer.
# Değişiklik: self-hosted.sh set-allowed-users "ad1,ad2"
SELF_HOSTED_ALLOWED_USERS=

# --- Topoloji ------------------------------------------------------------------
SELF_HOSTED_REGION_ID=self-hosted-1
SELF_HOSTED_NODE_ID=self-hosted-node-1
SELF_HOSTED_INSTANCE_ID=self-hosted-control-plane
SELF_HOSTED_OBJECT_BUCKET=self-hosted

# --- Kurulumda üretilen değerler (elle doldurmayın) ---------------------------
# SELF_HOSTED_PUBLIC_ORIGIN=https://workspace.example.com
# SELF_HOSTED_SOURCE_COMMIT=<git commit>
# SELF_HOSTED_PRODUCT_IMAGE=perseverance-self-hosted-product:<git commit>
# SELF_HOSTED_ORGANIZATION_ID=org_<rasgele>
# SELF_HOSTED_WORKSPACE_ID=wsp_<rasgele>
# SELF_HOSTED_POSTGRES_RUNTIME_PASSWORD=<openssl rand>
# SELF_HOSTED_BROKER_PASSWORD=<openssl rand>
# SELF_HOSTED_MINIO_ROOT_USER=self-hosted-operator
# SELF_HOSTED_MINIO_ROOT_PASSWORD=<openssl rand>
# SELF_HOSTED_TELEMETRY_SCOPE_SALT=<openssl rand>
# SELF_HOSTED_SECRETS_DIR=${SELF_HOSTED_HOME}/secrets
# SELF_HOSTED_CONFIG_DIR=${SELF_HOSTED_HOME}/config
# SELF_HOSTED_BACKUP_DIR=${SELF_HOSTED_HOME}/backups
# SELF_HOSTED_DIST_DIR=<infra/self-hosted dizininin mutlak yolu>
# SELF_HOSTED_MIGRATIONS_DIR=<infra/postgres/migrations mutlak yolu>
# + images.env içeriği (SELF_HOSTED_*_IMAGE)
